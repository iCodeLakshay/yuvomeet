{
  "name": "yuvomeet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @yuvomeet/shared test && node scripts/verify-security-rules.mjs",
    "check:security": "node scripts/verify-security-rules.mjs",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts",
    "db:test": "supabase test db",
    "functions:check": "cd supabase/functions && deno check */index.ts && deno test _shared/",
    "mobile:start": "pnpm --filter @yuvomeet/mobile start",
    "mobile:android": "pnpm --filter @yuvomeet/mobile android",
    "admin:dev": "pnpm --filter @yuvomeet/admin dev"
  },
  "devDependencies": {
    "typescript": "~5.8.2"
  },
  "pnpm": {
    "overrides": {
      "react-native": "0.86.3",
      "expo": "~57.0.31",
      "@expo/metro-runtime": "^57.0.17"
    }
  }
}
