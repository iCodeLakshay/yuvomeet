# Edge Function secrets. Local: copy to supabase/functions/.env (git-ignored) and run
# `supabase functions serve --env-file supabase/functions/.env`. Staging and production:
# `supabase secrets set --env-file ...`. SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are injected by Supabase and must not be set here.

APP_ENV=development
SENTRY_DSN=

# Shared with Postgres (Vault secret `internal_secret`) for pg_net -> push / analytics-flush.
INTERNAL_SECRET=
# Auth "Send SMS" hook secret (v1,whsec_...), same value as config.toml env(SEND_SMS_HOOK_SECRET).
SEND_SMS_HOOK_SECRET=
# HMAC keys: OTP lock key (phone never stored) and KYC identity fingerprint.
OTP_PEPPER=
KYC_PEPPER=

# MSG91 (DLT-registered OTP template).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# HyperVerge (leave empty locally: kyc-start applies a passing stub result).
HYPERVERGE_BASE_URL=
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=
HYPERVERGE_WORKFLOW_ID=
HYPERVERGE_WEBHOOK_SECRET=
KYC_REDIRECT_URL=yuvomeet://verify/result

# AWS Rekognition in ap-south-1 (leave empty locally with MODERATION_STUB=approve).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MODERATION_STUB=approve

# Expo push (optional access token for enhanced security).
EXPO_ACCESS_TOKEN=

# PostHog: project key for server-side events; personal key to delete persons on account deletion.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
