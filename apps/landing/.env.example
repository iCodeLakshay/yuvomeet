# Public, baked into the static build (next build). No secrets belong here.

# Canonical origin for metadata, sitemap and JSON-LD. Defaults to the app's default (https://hengout.app).
NEXT_PUBLIC_SITE_URL=https://hengout.app
# Support address shown as mailto links. Defaults to support@hengout.app.
NEXT_PUBLIC_SUPPORT_EMAIL=support@hengout.app
