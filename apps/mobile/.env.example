# Bundled into the app. EXPO_PUBLIC_* values are not secrets; never put the service role
# key or any vendor secret here (S-2).
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SUPPORT_EMAIL=support@yuvomeet.app
EXPO_PUBLIC_SITE_URL=https://yuvomeet.app

# Build time only (app config, EAS secrets).
GOOGLE_MAPS_ANDROID_API_KEY=
EAS_PROJECT_ID=
SENTRY_ORG=
SENTRY_PROJECT=
