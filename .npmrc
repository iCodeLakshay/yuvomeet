# Native Android builds on Windows fail when a file path exceeds 260 characters.
# pnpm's default virtual store (node_modules/.pnpm) pushes react-native-worklets over that limit.
virtual-store-dir=../.p

# Expo's config-plugins use Node's module resolution and cannot traverse pnpm's
# symlinked virtual store. Hoisted mode flattens node_modules so Expo can find packages.
node-linker=hoisted
